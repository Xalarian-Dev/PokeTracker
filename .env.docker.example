# Valeurs pour docker-compose.yml : copier ce fichier en « .env » (ignoré par git) puis le remplir.
# Ne JAMAIS publier le fichier .env rempli.

# Base de données. Le mot de passe : lettres et chiffres uniquement (il est inséré dans une adresse
# de connexion). Pour en générer un : openssl rand -hex 24
DB_USER=poketracker
DB_NAME=poketracker
DB_PASSWORD=

# Clerk (connexion des joueurs) : clés du projet Clerk, tableau de bord Clerk > API keys.
# La clé publique (pk_…) est intégrée au site ; la clé secrète (sk_…) reste sur le serveur.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
